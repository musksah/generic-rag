# Copy to .env and export these variables (e.g. `set -a; source .env; set +a`).
# Every variable is optional; the values below are the defaults.

# Google Cloud project for Vertex AI (defaults to the Application Default Credentials project)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
LLM_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=text-embedding-005

CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=state_of_the_union

RETRIEVAL_K=10
RERANK_TOP_N=3
RERANK_MODEL=ms-marco-MiniLM-L-12-v2

# DOCUMENT_PATH=documents/2024_state_of_the_union.txt
